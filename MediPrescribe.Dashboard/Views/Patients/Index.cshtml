@model IEnumerable<MediPrescribe.Dashboard.Models.PatientViewModel>
@{
    ViewData["Title"] = "المرضى";
}

<!-- Toolbar -->
<div class="toolbar-card">
    <div class="toolbar-right">
        <a asp-action="Create" class="btn btn-success">
            <i class="fa-solid fa-plus"></i> إضافة مريض
        </a>
    </div>
    <div class="toolbar-left">
        <button class="btn btn-outline">
            <i class="fa-solid fa-filter"></i> تصفية
        </button>
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="بحث في المرضى..." id="searchInput" onkeyup="filterTable()" />
        </div>
    </div>
</div>

<!-- Table -->
<div class="table-card">
    <div class="table-header">
        <h3>
            <i class="fa-solid fa-bed-pulse"></i>
            قائمة المرضى
        </h3>
    </div>
    <div class="table-responsive">
        <table class="data-table" id="patientsTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المريض</th>
                    <th>رقم الجوال</th>
                    <th>العنوان</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>@patient.Id</td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, #ecfdf5, #d1fae5); color: #059669; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">
                                    @patient.Name.Substring(0, Math.Min(1, patient.Name.Length))
                                </div>
                                <span style="font-weight: 600; color: var(--text-main);">@patient.Name</span>
                            </div>
                        </td>
                        <td>@patient.Phone</td>
                        <td>@(string.IsNullOrEmpty(patient.Address) ? "غير متوفر" : patient.Address)</td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Details" asp-route-id="@patient.Id" class="action-btn view" title="عرض">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@patient.Id" class="action-btn edit" title="تعديل">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@patient.Id" method="post" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من حذف هذا المريض؟');">
                                    <button type="submit" class="action-btn delete" title="حذف">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="table-empty">
                            <i class="fa-solid fa-users"></i>
                            لا توجد بيانات حالياً
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            var input = document.getElementById('searchInput');
            var filter = input.value.toLowerCase();
            var table = document.getElementById('patientsTable');
            var rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
            for (var i = 0; i < rows.length; i++) {
                var cells = rows[i].getElementsByTagName('td');
                var found = false;
                for (var j = 0; j < cells.length; j++) {
                    if (cells[j].textContent.toLowerCase().indexOf(filter) > -1) {
                        found = true;
                        break;
                    }
                }
                rows[i].style.display = found ? '' : 'none';
            }
        }
    </script>
}
