@model MediPrescribe.Dashboard.Models.PatientViewModel
@{
    ViewData["Title"] = "تعديل بيانات المريض";
}

<div class="form-card">
    <h3 class="form-card-title">
        <i class="fa-solid fa-pen"></i>
        تعديل بيانات المريض
    </h3>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger-msg"></div>

        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger-msg"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger-msg"></span>
        </div>

        <div class="form-group">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger-msg"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success">
                <i class="fa-solid fa-check"></i> تحديث البيانات
            </button>
            <a asp-action="Index" class="btn btn-outline">
                <i class="fa-solid fa-xmark"></i> إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
