@model MediPrescribe.Dashboard.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - MediPrescribe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Tajawal', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(160deg, #0c1222 0%, #0f172a 55%, #111c32 100%);
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            background: #ffffff;
            border-radius: 18px;
            padding: 38px 34px 32px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
        }

        .login-logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
        }

        .login-logo-img {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #edf1f7;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-logo-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .login-logo h1 {
            font-size: 1.35rem;
            font-weight: 800;
            color: #101828;
        }

        .login-logo p {
            font-size: 0.8rem;
            color: #8da0bd;
            font-weight: 500;
        }

        .form-group { margin-bottom: 18px; }

        .form-group label {
            display: block;
            font-size: 0.82rem;
            font-weight: 700;
            color: #344054;
            margin-bottom: 7px;
        }

        .form-group input {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid #e5eaf2;
            border-radius: 10px;
            font-family: inherit;
            font-size: 0.9rem;
            color: #101828;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-group input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .field-validation-error {
            display: block;
            font-size: 0.72rem;
            color: #dc2626;
            margin-top: 5px;
        }

        .login-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 0.82rem;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: #fff;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
        }

        .btn-login:hover { transform: translateY(-1px); }
        .btn-login:active { transform: translateY(0); }

        .login-hint {
            text-align: center;
            font-size: 0.72rem;
            color: #98a2b3;
            margin-top: 18px;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-img">
                <img src="~/images/logo.jpg" alt="MediPrescribe Logo" />
            </div>
            <h1>MediPrescribe</h1>
            <p>نظام الوصفات الطبي الذكي</p>
        </div>

        @{
            var generalErrors = ViewData.ModelState
                .Where(entry => string.IsNullOrEmpty(entry.Key))
                .SelectMany(entry => entry.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                .Select(error => error.ErrorMessage)
                .Where(message => !string.IsNullOrEmpty(message))
                .ToList();
        }

        @if (generalErrors.Count > 0)
        {
            <div class="login-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                @foreach (var error in generalErrors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="form-group">
                <label asp-for="Username">اسم المستخدم</label>
                <input asp-for="Username" autocomplete="username" placeholder="أدخل اسم المستخدم" />
                <span asp-validation-for="Username" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">كلمة المرور</label>
                <input asp-for="Password" autocomplete="current-password" placeholder="أدخل كلمة المرور" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-login">تسجيل الدخول</button>
        </form>

        <p class="login-hint">Admin: admin@mediprescribe.com / Admin@12345</p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>