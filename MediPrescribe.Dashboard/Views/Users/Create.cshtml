@model MediPrescribe.Dashboard.Models.UserViewModel
@{
    ViewData["Title"] = "إضافة مستخدم";
}

<div class="form-card">
    <h3 class="form-card-title">
        <i class="fa-solid fa-user-plus"></i>
        إضافة مستخدم جديد
    </h3>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger-msg"></div>

        <div class="form-group">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" placeholder="أدخل اسم المستخدم" />
            <span asp-validation-for="Username" class="text-danger-msg"></span>
        </div>

        <div class="form-group">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" placeholder="أدخل الاسم الكامل" />
            <span asp-validation-for="FullName" class="text-danger-msg"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" placeholder="example@domain.com" />
            <span asp-validation-for="Email" class="text-danger-msg"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" placeholder="أدخل رقم الهاتف" />
            <span asp-validation-for="Phone" class="text-danger-msg"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" placeholder="أدخل كلمة المرور" />
            <span asp-validation-for="Password" class="text-danger-msg"></span>
        </div>

        <div class="form-group">
            <label class="form-label">الدور</label>
            <select asp-for="Role" asp-items="ViewBag.Roles" class="form-control" id="roleSelect"></select>
        </div>

        <!-- Doctor Profile -->
        <div class="profile-fields" data-role="Doctor" style="display:none;">
            <div class="form-group">
                <label asp-for="Specialization" class="form-label"></label>
                <input asp-for="Specialization" class="form-control" placeholder="أدخل التخصص" />
                <span asp-validation-for="Specialization" class="text-danger-msg"></span>
            </div>
        </div>

        <!-- Pharmacist Profile -->
        <div class="profile-fields" data-role="Pharmacist" style="display:none;">
            <div class="form-group">
                <label asp-for="PharmacyName" class="form-label"></label>
                <input asp-for="PharmacyName" class="form-control" placeholder="أدخل اسم الصيدلية" />
                <span asp-validation-for="PharmacyName" class="text-danger-msg"></span>
            </div>
            <div class="form-group">
                <label asp-for="LicenseNumber" class="form-label"></label>
                <input asp-for="LicenseNumber" class="form-control" placeholder="أدخل رقم الترخيص" />
                <span asp-validation-for="LicenseNumber" class="text-danger-msg"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" placeholder="أدخل العنوان" />
                <span asp-validation-for="Address" class="text-danger-msg"></span>
            </div>
        </div>

        <!-- Patient Profile -->
        <div class="profile-fields" data-role="Patient" style="display:none;">
            <div class="form-group">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" placeholder="أدخل العنوان" />
                <span asp-validation-for="Address" class="text-danger-msg"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-check"></i> حفظ البيانات
            </button>
            <a asp-action="Index" class="btn btn-outline">
                <i class="fa-solid fa-xmark"></i> إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            updateProfileFields();
            document.getElementById('roleSelect').addEventListener('change', updateProfileFields);
        });

        function updateProfileFields() {
            var role = document.getElementById('roleSelect').value;
            var blocks = document.querySelectorAll('.profile-fields');
            blocks.forEach(function (block) {
                block.style.display = block.getAttribute('data-role') === role ? 'block' : 'none';
            });
        }
    </script>
}
